/* src/ui/style.qss */

/* Base Window & Dialogs */
QMainWindow, QDialog { 
    background-color: #ffffff; 
}
QWidget { 
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
}

/* Typography & Inputs */
QLabel { 
    font-weight: 600; 
    color: #374151; 
    font-size: 14px; 
}
QLineEdit, QComboBox { 
    padding: 12px; 
    border: 1px solid #d1d5db; 
    border-radius: 6px; 
    background: #f9fafb; 
    color: #111827; 
    font-size: 13px;
}
QLineEdit:focus, QComboBox:focus { 
    border: 1px solid #2563eb; 
    background: #ffffff; 
}

/* Primary Buttons */
QPushButton[class="primary"] {
    background-color: #2563eb;
    color: white;
    font-weight: bold;
    padding: 12px 16px;
    font-size: 14px;
    border: none;
    border-radius: 6px;
}
QPushButton[class="primary"]:hover { background-color: #1d4ed8; }
QPushButton[class="primary"]:disabled { background-color: #93c5fd; }

QPushButton[class="premium"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7c3aed, stop:1 #2563eb);
    color: white;
    font-weight: bold;
    padding: 12px 16px;
    font-size: 14px;
    border: none;
    border-radius: 6px;
}
QPushButton[class="premium"]:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6d28d9, stop:1 #1d4ed8); }
QPushButton[class="premium"]:disabled { background-color: #c4b5fd; }

/* Secondary Actions / Smaller Buttons */
QPushButton[class="secondary"] {
    background-color: #2563eb;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
}
QPushButton[class="secondary"]:hover { background-color: #1d4ed8; }

/* Outline/Gray Buttons */
QPushButton[class="outline"] {
    font-weight: bold;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 13px;
    border: none;
    background-color: #f3f4f6;
    color: #374151;
}
QPushButton[class="outline"]:hover { background-color: #e5e7eb; }

/* Special Labels (Success Dialog) */
QLabel[class="title"] { font-size: 18px; font-weight: bold; color: #10b981; }
QLabel[class="subtitle"] { font-size: 13px; color: #374151; }

/* DropZone Widget */
QWidget#drop_zone_widget {
    border: 2px dashed #93c5fd;
    border-radius: 12px;
    background: #eff6ff;
}
QWidget#drop_zone_widget QLabel {
    font-size: 15px;
    color: #2563eb;
    font-weight: bold;
    border: none;
    background: transparent;
}

/* Section Headers (Settings Dialog) */
.section-header {
    font-size: 15px;
    font-weight: 800;
    color: #1d4ed8;
    padding-top: 15px;
    padding-bottom: 5px;
}

/* Scrollbars & Selection polish */
QComboBox QAbstractItemView {
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

/* QScrollArea */
QScrollArea {
    border: none;
    background-color: transparent;
}

/* Custom Scrollbar - Modern & Clean */
QScrollBar:vertical {
    border: none;
    background: #f3f4f6;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #d1d5db;
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #9ca3af;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
